# The manuscript sources in docs/Graph_Rag/ are tracked so the paper can be
# written on either machine. Its LaTeX build products are not, and neither is
# the rejected first version.
paper/
docs/Graph_Rag/*.aux
docs/Graph_Rag/*.bbl
docs/Graph_Rag/*.blg
docs/Graph_Rag/*.fdb_latexmk
docs/Graph_Rag/*.fls
docs/Graph_Rag/*.log
docs/Graph_Rag/*.out
docs/Graph_Rag/*.pdf
docs/Graph_Rag/*.spl
docs/Graph_Rag/*.synctex.gz
docs/Graph_Rag/*.toc
docs/Graph_Rag/build/
docs/Graph_Rag/*_v1*
docs/Graph_Rag/results/

# Secrets
.env

# Built corpora and downloads (regenerated by `rag ingest`)
publaynet_corpus/
publaynet_images/*
!publaynet_images/captions.json
spiqa_corpus/
spiqa_download/
spiqa_images/*.png
spiqa_images/*.jpg
hotpotqa_corpus/
docbank_corpus/
docbank_images/
doclaynet_corpus/
doclaynet_images/

# Retrieval caches
.cache/

# Run outputs: only frozen, manifest-listed runs are committed under artifacts/runs/release/
artifacts/runs/*
!artifacts/runs/legacy/
!artifacts/runs/release/
artifacts/tables/*
!artifacts/tables/legacy/
artifacts/figures/*
!artifacts/figures/legacy/
# Runtime logs at the repository root only; archive/logs/ is kept for provenance.
/logs/

# Python and tooling
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.uv-cache/
.uv-python/
*.egg-info/
build/
dist/

# Editors and scratch
.vscode/
tmp/
